{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "stronux": {
      "type": "streamable-http",
      "url": "https://stronux.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "authorizationServerBase": "https://stronux.com/api/mcp/oauth",
            "resource": "https://stronux.com/api/mcp",
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
